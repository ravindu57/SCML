# ── SCML mediator ─────────────────────────────────
# On a second laptop, point this at the mediator's LAN address:
#   SCML_URL=http://192.168.1.42:8000
SCML_URL=http://localhost:8000
SCML_API_KEY=
# Groups this agent's decisions in the audit trail. View them at
#   audit.html?api=$SCML_URL&session=agent-live
SCML_SESSION=agent-live
SCML_TIMEOUT_MS=5000

# ── This agent ────────────────────────────────────
PORT=4000

# ── Intent selection (optional) ───────────────────
# Leave ANTHROPIC_API_KEY empty and the agent uses deterministic keyword intent
# matching — no key, no network, nothing to expire mid-demo. Set it and a real
# model chooses the tool instead. Either way the mediation boundary is the same.
ANTHROPIC_API_KEY=
DEMO_AGENT_MODEL=claude-sonnet-4-6
