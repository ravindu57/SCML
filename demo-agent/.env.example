# Demo agent settings — copy to .env and edit.
#
#     cp .env.example .env        (PowerShell: copy .env.example .env)
#     npm start
#
# .env is gitignored. Keep it that way: a key committed once stays in the
# history after you delete it, and the fix is revoking the key, not editing
# the file.
#
# Everything here is optional. With no .env at all the agent runs in
# deterministic mode — keyword routing, no network, no key. That mode is
# fully working, and is the safer choice for a live demonstration.

# ── Where the mediator is ────────────────────────────────────────────────────
# The agent's own machine if you are running both on one laptop; the
# mediator's LAN address if the agent is on a second one:
#   SCML_URL=http://192.168.1.42:8000
SCML_URL=http://127.0.0.1:8000

# Only needed when the mediator runs in production mode, which requires a key.
SCML_API_KEY=

# Groups this agent's decisions in the audit trail. View them at
#   audit.html?api=$SCML_URL&session=agent-live
SCML_SESSION=agent-live

# How long to wait for a mediation decision. On timeout the agent fails
# CLOSED for anything with a side effect — "could not ask" is not "allowed".
SCML_TIMEOUT_MS=5000

PORT=4000

# ── Model routing (optional) ─────────────────────────────────────────────────
# Set a key here and the agent asks a real model which tool a message maps to,
# and answers conversationally when none does. Leave it all commented out to
# stay deterministic.
#
# The model only *names* a tool. It never executes one and is never asked
# whether an action is allowed — SCML decides that from policy, afterwards.
#
# Pick ONE block.

# OpenAI — the key alone is enough, the rest defaults.
#OPENAI_API_KEY=sk-...
#DEMO_AGENT_MODEL=gpt-4o-mini

# Groq — free tier, fast.
#DEMO_AGENT_API_KEY=gsk_...
#DEMO_AGENT_BASE_URL=https://api.groq.com/openai/v1
#DEMO_AGENT_MODEL=llama-3.3-70b-versatile

# OpenRouter — one key, many models.
#DEMO_AGENT_API_KEY=sk-or-...
#DEMO_AGENT_BASE_URL=https://openrouter.ai/api/v1
#DEMO_AGENT_MODEL=meta-llama/llama-3.3-70b-instruct

# Google Gemini, via its OpenAI-compatible endpoint.
#DEMO_AGENT_API_KEY=AIza...
#DEMO_AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#DEMO_AGENT_MODEL=gemini-2.0-flash

# Anthropic.
#ANTHROPIC_API_KEY=sk-ant-...
#DEMO_AGENT_MODEL=claude-sonnet-4-6

# Ollama, running on this machine — no key, no network, nothing to leak, and
# nothing that venue wifi can take away mid-demonstration.
#     ollama pull llama3.1
#DEMO_AGENT_BASE_URL=http://localhost:11434/v1
#DEMO_AGENT_MODEL=llama3.1

# Provider is inferred from whichever key is set. Force it when that is wrong
# — an Anthropic key pointed at a proxy speaking the OpenAI shape, say.
#DEMO_AGENT_PROVIDER=openai
