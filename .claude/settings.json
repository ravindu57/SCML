{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/pytest*)",
      "Bash(.venv/bin/ruff*)",
      "Bash(.venv/bin/pip install*)",
      "Bash(.venv/bin/uvicorn*)",
      "Bash(docker compose*)",
      "Bash(curl http://localhost:8000/*)",
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(.venv/bin/python -m ruff*)",
      "Bash(.venv/bin/python -m benchmarks*)",
      "Bash(scripts/check_frozen.sh)"
    ],
    "deny": [
      "Read(.env)",
      "Read(trust_mediator.db)",
      "Bash(rm -rf*)"
    ],
    "ask": [
      "Bash(git push*)"
    ]
  },
  "env": {
    "TRUST_MEDIATOR_ENV": "development",
    "DATABASE_URL": "",
    "REDIS_URL": "",
    "TRUST_MEDIATOR_API_KEYS": "",
    "SCANNER_SHADOW_MODE": "false",
    "TRUST_MEDIATOR_ADMIN_API_KEYS": ""
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path') or d.get('tool_response',{}).get('filePath') or '')\"); case \"$f\" in *.py) out=$(\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python -m ruff check \"$f\" 2>&1) || { echo \"$out\" >&2; exit 2; };; esac",
            "timeout": 30,
            "statusMessage": "Linting with ruff"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/frozen_guard.py",
            "timeout": 10,
            "statusMessage": "Checking frozen paths"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  }
}
