# TrustMediator — Environment Configuration
# Copy to .env and fill in values. Never commit .env to source control.

# ── Service ──────────────────────────────────────────────────────────────────
TRUST_MEDIATOR_HOST=0.0.0.0
TRUST_MEDIATOR_PORT=8000
TRUST_MEDIATOR_ENV=development          # development | production
TRUST_MEDIATOR_LOG_LEVEL=INFO

# ── API keys and rotation (NFR-SEC-04) ───────────────────────────────────────
# TRUST_MEDIATOR_API_KEYS is read once at startup, so rotating a key set here
# needs a restart. Point this at a file instead — a Kubernetes Secret volume,
# a Vault Agent template, an External Secrets Operator output — and the
# mediator re-reads it while running. The file wins over the env var.
#   Format: one entry per line, "#" comments allowed. Each entry is a bare key
#   or "name:key"; the name is recorded as the reviewer/actor on admin calls.
#   Rotate: add the new key, let clients migrate, remove the old one.
#   Revoke: remove the entry, or empty the file to revoke everything. Do not
#           delete the file — that reads as a broken mount, and the last good
#           key set is retained on purpose.
TRUST_MEDIATOR_API_KEYS_FILE=
TRUST_MEDIATOR_API_KEYS_RELOAD_SECONDS=5

# ── TLS / mTLS (NFR-SEC-03) ──────────────────────────────────────────────────
# Setting both of these enables TLS on the HTTP and gRPC listeners.
TRUST_MEDIATOR_TLS_CERT_FILE=
TRUST_MEDIATOR_TLS_KEY_FILE=
# CA used to verify *client* certificates, plus the switch that requires one.
TRUST_MEDIATOR_TLS_CA_FILE=
TRUST_MEDIATOR_TLS_REQUIRE_CLIENT_CERT=false
# With TRUST_MEDIATOR_ENV=production and no certificate above, the process
# refuses to start. Set this to true when TLS terminates in front of it
# (ingress, service mesh, nginx) — it makes that an explicit, greppable
# decision instead of the silent default it used to be.
TRUST_MEDIATOR_ALLOW_INSECURE_HTTP=false
TRUST_MEDIATOR_SECRET_KEY=change-me-to-a-random-256-bit-secret

# ── API Key Authentication ────────────────────────────────────────────────────
# Comma-separated list of valid API keys for the X-API-Key header.
# Leave empty in development for open access (no auth required).
# In production, set at least one key: sk-<random32chars>
# Generate a key: python3 -c "import secrets; print('sk-'+secrets.token_hex(16))"
TRUST_MEDIATOR_API_KEYS=

# ── Database ──────────────────────────────────────────────────────────────────
# Leave DATABASE_URL blank to use SQLite (local dev)
DATABASE_URL=
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trust_mediator

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave blank to use in-memory cache
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# ── Injection Scanner ─────────────────────────────────────────────────────────
SCANNER_BACKEND=heuristic              # heuristic | onnx | llm
SCANNER_SHADOW_MODE=false
SCANNER_BLOCK_THRESHOLD=0.85
SCANNER_ESCALATE_THRESHOLD=0.70
SCANNER_TRANSFORM_THRESHOLD=0.50
# Heuristic score at or above which the ML classifier (stage 2) is consulted.
# A cost control, but it caps recall: stage 2 only sees what the regex stage
# already suspects, and the regex scores 0.0 on ~94% of untrusted content, so
# at the default an LLM backend is never called on it. Set 0.0 to scan
# everything — but only with a classifier that can discriminate. Measured on
# InjecAgent with the shipped TF-IDF model, 0.0 takes FPR 0.0% -> 23.5% and
# utility 100% -> 76.5%, failing two KPIs to catch 19.7% more.
SCANNER_ML_GATE_THRESHOLD=0.20

# ── Optional: LLM-backed scanner / alignment auditor ─────────────────────────
LLM_SCANNER_API_KEY=
LLM_SCANNER_BASE_URL=https://api.openai.com/v1
LLM_SCANNER_MODEL=gpt-4o-mini
LLM_SCANNER_NO_RETENTION=true          # instruct provider not to retain content

# ── Memory Integrity ──────────────────────────────────────────────────────────
MEMORY_INTEGRITY_THRESHOLD=0.65        # below this → quarantine/reject
# FR-MI-04 — re-verify memory on read so entries written before a policy
# update are still checked. Turning this off makes a Must requirement opt-out;
# measured cost is ~4ms against the 400ms fast-path budget.
MEMORY_RESCAN_ON_READ=true

# ── Consistency checker (FR-MI-02) ────────────────────────────────────────────
# The largest single contributor to the memory-poisoning defence: disabling it
# takes ASR 33.3% -> 64.6%, a bigger swing than the injection scanner. These
# were literals in consistency_checker.py, so the layer doing most of the work
# was the one that could not be adjusted without a code change.
#
# Do NOT tune these against benchmarks/testbeds/memory_poisoning — that corpus
# was written in-house, so fitting to it is memorisation, not security. Tune
# against external validation (benchmarks/testbeds/injecagent) or your own
# traffic.
MEMORY_CONSISTENCY_SUSPICION_THRESHOLD=0.40  # combined_risk above this → flagged
MEMORY_CONTRADICTION_OVERLAP_MIN=0.25        # min token overlap to compare two entries
MEMORY_NEGATION_DIVERGENCE_MIN=0.30          # min negation before "contradiction"
# Which records get *named* as contradicted. Unlike the two above it does not
# change the verdict, only the evidence cited for review — raising it hides
# which memory was contradicted while still quarantining the write.
MEMORY_CONTRADICTION_REPORT_MIN=0.30

# ── Audit / SIEM ──────────────────────────────────────────────────────────────
AUDIT_SIEM_WEBHOOK_URL=                # optional SIEM webhook
AUDIT_KAFKA_BOOTSTRAP=                 # optional Kafka for audit events

# Events coalesced into one DB transaction. Per-event writes measured
# ~140 events/s and made audit the throughput ceiling; 1 restores that.
AUDIT_BATCH_MAX=128
# Bound on the in-memory queue. 0 = unbounded (grows until the process dies
# and takes every queued decision with it). Size this for your peak load.
AUDIT_QUEUE_MAXSIZE=10000
# What to drop once the queue is full: drop_newest keeps the existing backlog,
# drop_oldest prefers recent events. Either way the count is written into the
# affected session's hash chain as an `audit_gap` marker.
AUDIT_OVERFLOW_POLICY=drop_newest

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# slowapi limit string: "200/minute", "500/minute", "10/second", etc.
TRUST_MEDIATOR_RATE_LIMIT=200/minute

# ── Human-in-the-Loop Escalation Webhook ─────────────────────────────────────
# When a mediation decision = "escalate", POST a JSON alert to this URL.
# Supports: Slack Incoming Webhooks, MS Teams, PagerDuty, or any HTTP endpoint.
# Leave empty to skip escalation notifications (safe default).
# Examples:
#   Slack:   https://hooks.slack.com/services/T.../B.../...
#   Teams:   https://outlook.office.com/webhook/...
#   Generic: https://your-ops-team.example.com/alerts
TRUST_MEDIATOR_ESCALATION_WEBHOOK_URL=
TRUST_MEDIATOR_ESCALATION_TIMEOUT_S=5  # HTTP timeout for webhook calls

# ── gRPC API (FR-IG-02) ───────────────────────────────────────────────────────
TRUST_MEDIATOR_GRPC_ENABLED=false      # requires: pip install "trust-mediator[grpc]"
TRUST_MEDIATOR_GRPC_PORT=50051

# ── HTTP hardening (production) ──────────────────────────────────────────────
# Comma-separated CORS origins allowed in production (dev allows all):
TRUST_MEDIATOR_CORS_ORIGINS=
# Comma-separated allowed Host header values (empty = rely on ingress):
TRUST_MEDIATOR_TRUSTED_HOSTS=
# Emit Strict-Transport-Security once TLS terminates in front:
TRUST_MEDIATOR_HSTS_ENABLED=false

# ── Policy ────────────────────────────────────────────────────────────────────
POLICY_DEFAULT_FILE=policies/default_policy.yaml

# ── Observability ─────────────────────────────────────────────────────────────
# Set to enable distributed tracing (NFR-OBS-01). Leave blank and no tracer
# provider is installed at all — instrumentation costs nothing when unused.
# Exporting requires the optional extra:  pip install -e ".[otlp]"
OTEL_EXPORTER_OTLP_ENDPOINT=           # e.g. http://otel-collector:4318
OTEL_SERVICE_NAME=trust-mediator
